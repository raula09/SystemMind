<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DiagnoX.ViewModels"
        xmlns:models="using:DiagnoX.Models"
        xmlns:controls="using:DiagnoX.Controls"
        x:Class="DiagnoX.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1480" Height="920" MinWidth="1240" MinHeight="750"
        Background="#14171B"
        Foreground="#E6E8EB"
        FontFamily="avares://Avalonia.Fonts.Inter/Assets#Inter"
        FontSize="12"
        Title="DiagnoX"
        Icon="avares://DiagnoX/images/Logo.png">

  <Window.Styles>
    <!--
      Tokens
        content  #14171B   sidebar #1A1D22   card #1E2228   inset #171A1E
        line     #2A2F36   text #E6E8EB      muted #8A929C  dim #5E6670
        blue     #4D96F0   orange #F2994A    green #3FCF6B  red #FF5F57
        yellow   #F5C84C   purple #B65CF0
    -->

    <!-- ============ TYPOGRAPHY ============ -->
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="#8A929C"/></Style>
    <Style Selector="TextBlock.dim"><Setter Property="Foreground" Value="#5E6670"/></Style>
    <Style Selector="TextBlock.eyebrow">
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Foreground" Value="#7B848E"/>
    </Style>
    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="20"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="LetterSpacing" Value="-0.3"/>
    </Style>
    <Style Selector="TextBlock.cardtitle">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#F0F2F4"/>
    </Style>
    <Style Selector="TextBlock.num">
      <Setter Property="FontFamily" Value="Cascadia Mono, JetBrains Mono, Menlo, Consolas, monospace"/>
    </Style>
    <Style Selector="TextBlock.big">
      <Setter Property="FontFamily" Value="Cascadia Mono, JetBrains Mono, Menlo, Consolas, monospace"/>
      <Setter Property="FontSize" Value="24"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="LetterSpacing" Value="-0.6"/>
    </Style>

    <!-- ============ SURFACES ============ -->
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="#1E2228"/>
      <Setter Property="BorderBrush" Value="#2A2F36"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="16"/>
    </Style>
    <!-- Dashboard cards fill their grid cell, so every row is the same size at any window width.
         Gaps come from spacer grid columns, keeping the outer edges flush with the header. -->
    <Style Selector="Border.dashboard-card">
      <Setter Property="Background" Value="#0D1318"/>
      <Setter Property="BorderBrush" Value="#25313A"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="MinHeight" Value="250"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="ClipToBounds" Value="True"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Border.dashboard-card:pointerover">
      <Setter Property="Background" Value="#111C22"/>
      <Setter Property="BorderBrush" Value="#00AEEF"/>
    </Style>
    <Style Selector="Border.dashboard-insights">
      <Setter Property="BorderBrush" Value="#FFB23F"/>
      <Setter Property="BorderThickness" Value="3,1,1,1"/>
      <Setter Property="MinHeight" Value="0"/>
    </Style>
    <Style Selector="Border.metric-card">
      <Setter Property="MinHeight" Value="210"/>
    </Style>
    <Style Selector="Border.dashboard-bottom-card">
      <Setter Property="MinHeight" Value="190"/>
    </Style>
    <Style Selector="Border.dashboard-card TextBlock.cardtitle">
      <Setter Property="Foreground" Value="#DCE7EC"/>
      <Setter Property="LetterSpacing" Value="0.8"/>
    </Style>
    <Style Selector="Button.dashboard-action">
      <Setter Property="Background" Value="#00AEEF"/>
      <Setter Property="BorderBrush" Value="#00AEEF"/>
      <Setter Property="Foreground" Value="#041014"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="Padding" Value="14,8"/>
    </Style>
    <Style Selector="Border.inset">
      <Setter Property="Background" Value="#171A1E"/>
      <Setter Property="BorderBrush" Value="#2A2F36"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <!-- Storage uses the denser, square-edged system monitor treatment. -->
    <Style Selector="Border.storage-surface">
      <Setter Property="Background" Value="#0D1318"/>
      <Setter Property="BorderBrush" Value="#25313A"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="0"/>
    </Style>
    <Style Selector="Border.storage-toolbar">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="0"/>
    </Style>
    <Style Selector="Button.storage-action">
      <Setter Property="Background" Value="#0D1318"/>
      <Setter Property="BorderBrush" Value="#2B3B45"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="Padding" Value="14,8"/>
    </Style>
    <Style Selector="Button.storage-action:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#10212A"/>
      <Setter Property="BorderBrush" Value="#00AEEF"/>
    </Style>
    <Style Selector="Button.storage-chip">
      <Setter Property="Background" Value="#0D1318"/>
      <Setter Property="BorderBrush" Value="#2B3B45"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="FontSize" Value="10.5"/>
      <Setter Property="Foreground" Value="#A9B7C2"/>
    </Style>
    <Style Selector="TextBox.storage-path">
      <Setter Property="Background" Value="#0D1318"/>
      <Setter Property="BorderBrush" Value="#2B3B45"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="Padding" Value="12,8"/>
    </Style>
    <Style Selector="Border.storage-drive">
      <Setter Property="Background" Value="#0D1318"/>
      <Setter Property="BorderBrush" Value="#25313A"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="0"/>
    </Style>
    <Style Selector="Button.storage-drive">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="Padding" Value="10"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="Button.storage-drive:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#10212A"/>
    </Style>
    <Style Selector="Border.process-surface">
      <Setter Property="Background" Value="#0D1318"/>
      <Setter Property="BorderBrush" Value="#25313A"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="0"/>
    </Style>
    <Style Selector="Button.process-action">
      <Setter Property="Background" Value="#0D1318"/>
      <Setter Property="BorderBrush" Value="#2B3B45"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="Padding" Value="14,8"/>
    </Style>
    <Style Selector="Button.process-action:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#10212A"/>
      <Setter Property="BorderBrush" Value="#00AEEF"/>
    </Style>
    <Style Selector="TextBox.process-search">
      <Setter Property="Background" Value="#0A1014"/>
      <Setter Property="BorderBrush" Value="#2B3B45"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="Padding" Value="12,8"/>
    </Style>
    <Style Selector="ListBox.process-list">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ListBox.process-list > ListBoxItem">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="CornerRadius" Value="0"/>
    </Style>
    <Style Selector="ListBox.process-list > ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#10212A"/>
    </Style>
    <Style Selector="Border.health-surface">
      <Setter Property="Background" Value="#0D1318"/>
      <Setter Property="BorderBrush" Value="#25313A"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="0"/>
    </Style>
    <Style Selector="Button.health-action">
      <Setter Property="Background" Value="#0D1318"/>
      <Setter Property="BorderBrush" Value="#2B3B45"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="Padding" Value="14,8"/>
    </Style>
    <Style Selector="Button.health-action:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#10212A"/>
      <Setter Property="BorderBrush" Value="#00AEEF"/>
    </Style>
    <Style Selector="TextBox.health-filter, ComboBox.health-filter">
      <Setter Property="Background" Value="#0A1014"/>
      <Setter Property="BorderBrush" Value="#2B3B45"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="0"/>
    </Style>
    <Style Selector="Border.health-category">
      <Setter Property="Background" Value="#0D1318"/>
      <Setter Property="BorderBrush" Value="#2B3B45"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="0"/>
    </Style>
    <Style Selector="Border.cleanup-surface">
      <Setter Property="Background" Value="#0D1318"/>
      <Setter Property="BorderBrush" Value="#25313A"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="0"/>
    </Style>
    <Style Selector="Border.cleanup-row">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="#25313A"/>
      <Setter Property="BorderThickness" Value="0,1,0,0"/>
      <Setter Property="CornerRadius" Value="0"/>
    </Style>
    <Style Selector="Button.cleanup-action">
      <Setter Property="Background" Value="#0D1318"/>
      <Setter Property="BorderBrush" Value="#2B3B45"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="Padding" Value="14,8"/>
    </Style>
    <Style Selector="Button.cleanup-action:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#10212A"/>
      <Setter Property="BorderBrush" Value="#00AEEF"/>
    </Style>

    <Style Selector="Button">
      <Setter Property="Background" Value="#262B32"/>
      <Setter Property="BorderBrush" Value="#323841"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="#DADEE3"/>
      <Setter Property="CornerRadius" Value="7"/>
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#2E343C"/>
      <Setter Property="BorderBrush" Value="#3C434D"/>
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#20252B"/>
    </Style>
    <Style Selector="Button:disabled"><Setter Property="Opacity" Value="0.4"/></Style>

    <Style Selector="Button.sm"><Setter Property="Padding" Value="9,4"/><Setter Property="FontSize" Value="11"/></Style>

    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#4D96F0"/>
      <Setter Property="BorderBrush" Value="#4D96F0"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#6AABF5"/>
      <Setter Property="BorderBrush" Value="#6AABF5"/>
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#3C84DC"/>
    </Style>

    <Style Selector="Button.danger">
      <Setter Property="Background" Value="#32191B"/>
      <Setter Property="BorderBrush" Value="#613034"/>
      <Setter Property="Foreground" Value="#FF8D87"/>
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#42211F"/>
      <Setter Property="BorderBrush" Value="#82403F"/>
    </Style>

    <Style Selector="Button.chip">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="#323841"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="11,4"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="#A2AAB3"/>
    </Style>
    <Style Selector="Button.chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#1F2B3A"/>
      <Setter Property="BorderBrush" Value="#3A6BA8"/>
    </Style>

    <Style Selector="Button.tile">
      <Setter Property="Background" Value="#171A1E"/>
      <Setter Property="BorderBrush" Value="#2A2F36"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="12,10"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="Button.tile:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#1D2630"/>
      <Setter Property="BorderBrush" Value="#3A6BA8"/>
    </Style>

    <Style Selector="Button.nav">
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="#A9B7C2"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="Padding" Value="14,11"/>
      <Setter Property="FontSize" Value="16"/>
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#111A20"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="Button.nav-active">
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="Background" Value="#121A20"/>
      <Setter Property="BorderBrush" Value="#00AEEF"/>
      <Setter Property="BorderThickness" Value="2,0,0,0"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="Padding" Value="12,11"/>
      <Setter Property="FontSize" Value="16"/>
    </Style>
    <Style Selector="Button.nav-active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#121A20"/>
      <Setter Property="BorderBrush" Value="#00AEEF"/>
    </Style>

    <Style Selector="Button.iconbtn">
      <Setter Property="Background" Value="#22262C"/>
      <Setter Property="BorderBrush" Value="#2E333A"/>
      <Setter Property="Padding" Value="8,5"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="Button.send-icon">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Background" Value="#00AEEF"/>
      <Setter Property="BorderBrush" Value="#00AEEF"/>
    </Style>

    <Style Selector="ToggleButton">
      <Setter Property="Background" Value="#262B32"/>
      <Setter Property="BorderBrush" Value="#323841"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="#DADEE3"/>
      <Setter Property="CornerRadius" Value="7"/>
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="ToggleButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#2E343C"/>
      <Setter Property="BorderBrush" Value="#3C434D"/>
    </Style>
    <Style Selector="ToggleButton:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#1F2B3A"/>
      <Setter Property="BorderBrush" Value="#3A6BA8"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>

    <Style Selector="TextBox">
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Background" Value="#171A1E"/>
      <Setter Property="BorderBrush" Value="#2E333A"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="Padding" Value="12,8"/>
    </Style>
    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="#171A1E"/>
      <Setter Property="BorderBrush" Value="#3C434D"/>
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="#171A1E"/>
      <Setter Property="BorderBrush" Value="#4D96F0"/>
    </Style>
    <Style Selector="Border.chat-rail TextBox">
      <Setter Property="Background" Value="#0A1014"/>
      <Setter Property="BorderBrush" Value="#263842"/>
      <Setter Property="Foreground" Value="#E3EEF3"/>
    </Style>
    <Style Selector="Border.chat-rail TextBox:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="#0A1014"/>
      <Setter Property="BorderBrush" Value="#00AEEF"/>
    </Style>
    <Style Selector="Border.chat-rail Button.chip">
      <Setter Property="BorderBrush" Value="#2B3B45"/>
      <Setter Property="CornerRadius" Value="2"/>
      <Setter Property="Foreground" Value="#A9B7C2"/>
      <Setter Property="Padding" Value="8,4"/>
    </Style>
    <Style Selector="Border.chat-rail Button.chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#10212A"/>
      <Setter Property="BorderBrush" Value="#00AEEF"/>
    </Style>
    <Style Selector="GridSplitter.pane-resizer">
      <Setter Property="Background" Value="#1D2A33"/>
      <Setter Property="Cursor" Value="SizeWestEast"/>
    </Style>
    <Style Selector="GridSplitter.pane-resizer:pointerover">
      <Setter Property="Background" Value="#00AEEF"/>
    </Style>

    <Style Selector="CheckBox"><Setter Property="Foreground" Value="#DADEE3"/></Style>

    <Style Selector="ProgressBar">
      <Setter Property="Height" Value="4"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Foreground" Value="#4D96F0"/>
      <Setter Property="Background" Value="#2C323A"/>
      <Setter Property="CornerRadius" Value="2"/>
    </Style>
    <Style Selector="ProgressBar /template/ Border#PART_Indicator"><Setter Property="CornerRadius" Value="2"/></Style>

    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="CornerRadius" Value="6"/>
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#22262C"/></Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#1F2B3A"/></Style>
    <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#24344A"/></Style>

    <Style Selector="TreeViewItem:pointerover /template/ ContentPresenter#PART_HeaderPresenter"><Setter Property="Background" Value="#22262C"/></Style>
    <Style Selector="TreeViewItem:selected /template/ ContentPresenter#PART_HeaderPresenter"><Setter Property="Background" Value="#1F2B3A"/></Style>

    <Style Selector="ScrollViewer"><Setter Property="AllowAutoHide" Value="True"/></Style>
  </Window.Styles>

  <!-- ROOT: navigation | resizer | workspace | resizer | assistant rail -->
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="280" MinWidth="220" MaxWidth="420"/>
      <ColumnDefinition Width="6"/>
      <ColumnDefinition Width="*" MinWidth="500"/>
      <ColumnDefinition Width="6"/>
      <ColumnDefinition Width="420" MinWidth="300" MaxWidth="600"/>
    </Grid.ColumnDefinitions>

    <Border Classes="sidebar-shell" Background="#080C0F" BorderBrush="#1D2A33" BorderThickness="0,0,1,0" Padding="10,14,10,12">
      <Grid RowDefinitions="Auto,*,Auto">

        <StackPanel Orientation="Horizontal" Spacing="9" Margin="8,2,0,20">
          <Border Width="28" Height="22" CornerRadius="5" ClipToBounds="True" Background="#0D2430">
            <Image Source="avares://DiagnoX/images/Logo.png" Stretch="Uniform"/>
          </Border>
          <TextBlock Text="DiagnoX" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="2">
          <TextBlock Text="Monitoring" Classes="eyebrow" FontSize="13" Margin="14,0,0,10"/>

          <Button Classes.nav-active="{Binding IsOverviewActive}" Classes.nav="{Binding !IsOverviewActive}"
                  Command="{Binding SetViewCommand}" CommandParameter="Overview">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Path Width="17" Height="17" Stretch="Uniform" StrokeThickness="1.3" StrokeLineCap="Round" StrokeJoin="Round"
                    Stroke="#00AEEF" Data="M2,2 H6.5 V6.5 H2 Z M8.5,2 H13 V6.5 H8.5 Z M2,8.5 H6.5 V13 H2 Z M8.5,8.5 H13 V13 H8.5 Z"/>
              <TextBlock Text="Dashboard" Foreground="{Binding $parent[Button].Foreground}"/>
            </StackPanel>
          </Button>

          <Button Classes.nav-active="{Binding IsStorageExplorerActive}" Classes.nav="{Binding !IsStorageExplorerActive}"
                  Command="{Binding SetViewCommand}" CommandParameter="StorageExplorer">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Path Width="17" Height="17" Stretch="Uniform" StrokeThickness="1.3" StrokeLineCap="Round" StrokeJoin="Round"
                    Stroke="#3FCF6B" Data="M1.5,4 H5.5 L7,5.5 H13 V12 H1.5 Z"/>
              <TextBlock Text="Storage" Foreground="{Binding $parent[Button].Foreground}"/>
            </StackPanel>
          </Button>

          <Button Classes.nav-active="{Binding IsPerformanceActive}" Classes.nav="{Binding !IsPerformanceActive}"
                  Command="{Binding SetViewCommand}" CommandParameter="Performance">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Path Width="17" Height="17" Stretch="Uniform" StrokeThickness="1.3" StrokeLineCap="Round" StrokeJoin="Round"
                    Stroke="#F2994A" Data="M2,3.5 H13 M2,7.5 H13 M2,11.5 H8.5"/>
              <TextBlock Text="Processes" Foreground="{Binding $parent[Button].Foreground}"/>
            </StackPanel>
          </Button>

          <Button Classes.nav-active="{Binding IsAnomaliesActive}" Classes.nav="{Binding !IsAnomaliesActive}"
                  Command="{Binding SetViewCommand}" CommandParameter="Anomalies">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Path Width="17" Height="17" Stretch="Uniform" StrokeThickness="1.3" StrokeLineCap="Round"
                    Stroke="#F0525F" Data="M7,1 L13,12.5 H1 Z M7,5 V8.5 M7,10.7 V10.8"/>
              <TextBlock Text="System Health" Foreground="{Binding $parent[Button].Foreground}"/>
            </StackPanel>
          </Button>

          <TextBlock Text="Tools" Classes="eyebrow" FontSize="13" Margin="14,18,0,10"/>

          <Button Classes.nav-active="{Binding IsCleanupActive}" Classes.nav="{Binding !IsCleanupActive}"
                  Command="{Binding SetViewCommand}" CommandParameter="Cleanup">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Path Width="17" Height="17" Stretch="Uniform" StrokeThickness="1.3" StrokeLineCap="Round" StrokeJoin="Round"
                    Stroke="#F5C84C" Data="M2.5,4 H12.5 M5.5,4 V2.2 H9.5 V4 M3.7,4 L4.3,12.5 H10.7 L11.3,4"/>
              <TextBlock Text="Cleanup" Foreground="{Binding $parent[Button].Foreground}"/>
            </StackPanel>
          </Button>

        </StackPanel>

      </Grid>
    </Border>

    <GridSplitter Grid.Column="1" Classes="pane-resizer" ResizeDirection="Columns"
                  ResizeBehavior="PreviousAndNext" ShowsPreview="False"/>

    <!-- ===================== WORKSPACE ===================== -->
    <Grid Grid.Column="2" Background="#080C0F" RowDefinitions="Auto,*">

      <!-- Status banner -->
      <Border IsVisible="{Binding HasStatusBanner}" Background="#1A2634" BorderBrush="#3A6BA8" BorderThickness="1"
              CornerRadius="10" Margin="20,14,20,0" Padding="14,9">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Ellipse Width="6" Height="6" Fill="#4D96F0" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding StatusBanner}" Foreground="#D4E5F8" FontWeight="Medium" VerticalAlignment="Center"/>
        </StackPanel>
      </Border>

      <!-- Views share row 1 -->
      <Grid Grid.Row="1">

        <!-- ============ VIEW: DASHBOARD ============ -->
        <!-- Gutters are a Margin on the content, not ScrollViewer.Padding: in Avalonia 11.2 the padding is
             ignored while measuring, so wide content got arranged past the right edge and clipped. -->
        <ScrollViewer Classes="overview" IsVisible="{Binding IsOverviewActive}"
                      Background="#080C0F" HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="DashboardContent" Spacing="12" Margin="28,24,28,20" SizeChanged="DashboardContent_OnSizeChanged">

            <!-- Header -->
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
              <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock Text="SYSTEM OVERVIEW" Classes="eyebrow" FontSize="10.5"/>
                <TextBlock Text="·" Classes="dim"/>
                <TextBlock Text="{Binding CpuDetail}" Classes="dim num" FontSize="10.5" VerticalAlignment="Center"/>
                <Ellipse Width="5" Height="5" Fill="#45D6A1" VerticalAlignment="Center"/>
                <TextBlock Text="LIVE" Foreground="#45D6A1" FontSize="10" FontWeight="SemiBold" LetterSpacing="1"/>
              </StackPanel>
              <Button Grid.Column="1" Classes="dashboard-action" Content="Refresh" Command="{Binding RefreshCommand}"/>
            </Grid>

            <!-- Full-width health summary, followed by compact metric rows. -->
            <StackPanel Spacing="14">

              <!-- INSIGHTS -->
              <Border Classes="panel dashboard-card dashboard-insights" Tag="Insights" PointerPressed="DashboardCard_OnPointerPressed">
                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Path Width="14" Height="14" Stretch="Uniform" Fill="#F5C84C" VerticalAlignment="Center"
                            Data="M7,1 C4.2,1 2.2,3 2.2,5.6 C2.2,7.3 3,8.4 3.9,9.3 C4.4,9.8 4.6,10.3 4.6,11 H9.4 C9.4,10.3 9.6,9.8 10.1,9.3 C11,8.4 11.8,7.3 11.8,5.6 C11.8,3 9.8,1 7,1 Z M5,12.2 H9 V13.2 H5 Z"/>
                      <TextBlock Text="Insights" Classes="cardtitle"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#2A2410" BorderBrush="#5C4A14" BorderThickness="1" CornerRadius="9" Padding="7,1">
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="{Binding Recommendations.Count}" Classes="num" FontSize="10.5" Foreground="#F5C84C" FontWeight="SemiBold"/>
                        <TextBlock Text="items" FontSize="10.5" Foreground="#F5C84C"/>
                      </StackPanel>
                    </Border>
                  </Grid>
                  <ItemsControl ItemsSource="{Binding Recommendations}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border BorderBrush="#2A2F36" BorderThickness="0,0,0,1" Padding="0,8">
                          <Grid ColumnDefinitions="Auto,*,Auto">
                            <Grid Width="13" Height="13" Margin="0,1,9,0" VerticalAlignment="Top">
                              <Path IsVisible="{Binding IsUrgent}" Stretch="Uniform" Fill="{Binding Accent}" Data="M7,1 L13,12.5 H1 Z"/>
                              <Ellipse IsVisible="{Binding !IsUrgent}" Fill="{Binding Accent}"/>
                              <Path IsVisible="{Binding !IsUrgent}" Stroke="#0D1318" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round"
                                    Data="M3.6,6.7 L5.6,8.7 L9.4,4.6"/>
                            </Grid>
                            <StackPanel Grid.Column="1" Spacing="3">
                              <TextBlock Text="{Binding Title}" FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="15"/>
                              <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="10.5" FontStyle="Italic" TextWrapping="Wrap" LineHeight="14"/>
                            </StackPanel>
                            <Path Grid.Column="2" Width="6" Height="10" Stretch="Uniform" StrokeThickness="1.3" Stroke="#5E6670"
                                  StrokeLineCap="Round" StrokeJoin="Round" Data="M1,1 L5,5 L1,9" Margin="8,4,0,0" VerticalAlignment="Top"/>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

              <!-- Column counts are re-flowed in code-behind for narrow workspaces. -->
              <Grid x:Name="MetricCards" ColumnDefinitions="*,14,*,14,*,14,*">

              <!-- CPU -->
              <Border Classes="panel dashboard-card metric-card" Tag="CPU" PointerPressed="DashboardCard_OnPointerPressed">
                <StackPanel Spacing="12">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Border Width="14" Height="14" CornerRadius="3" Background="#00AEEF" VerticalAlignment="Center"/>
                      <TextBlock Text="CPU" Classes="cardtitle"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="Details ›" Classes="dim" FontSize="10.5"/>
                  </Grid>
                  <controls:RingGauge Width="100" Height="100" Thickness="9" Stroke="#00AEEF" ValueText="{Binding CpuHeadline}" Caption="CPU"
                                      HorizontalAlignment="Center"/>
                  <TextBlock Text="{Binding CpuDetail}" Classes="dim num" FontSize="10" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                  <controls:TelemetryChartControl Values="{Binding CpuHistory}" Stroke="#00AEEF" Height="32"/>
                </StackPanel>
              </Border>

              <!-- MEMORY -->
              <Border Grid.Column="2" Classes="panel dashboard-card metric-card" Tag="Memory" PointerPressed="DashboardCard_OnPointerPressed">
                <StackPanel Spacing="12">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Border Width="14" Height="14" CornerRadius="3" Background="#00AEEF" VerticalAlignment="Center"/>
                      <TextBlock Text="Memory" Classes="cardtitle"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="Details ›" Classes="dim" FontSize="10.5"/>
                  </Grid>
                  <controls:RingGauge Width="100" Height="100" Thickness="9" Stroke="#00AEEF" Value="{Binding MemoryPercent}"
                                      ValueText="{Binding MemoryPercent, StringFormat='{}{0:F1}%'}" Caption="RAM"
                                      HorizontalAlignment="Center"/>
                  <TextBlock Text="{Binding MemoryHeadline}" Classes="num" FontSize="10.5" HorizontalAlignment="Center"/>
                  <TextBlock Text="{Binding MemoryDetail}" Classes="dim" FontSize="10" HorizontalAlignment="Center"/>
                  <controls:TelemetryChartControl Values="{Binding MemoryHistory}" Stroke="#00AEEF" Height="26"/>
                </StackPanel>
              </Border>

              <!-- GPU -->
              <Border Grid.Column="4" Classes="panel dashboard-card metric-card" x:CompileBindings="False" Tag="GPU" PointerPressed="DashboardCard_OnPointerPressed">
                <StackPanel Spacing="12">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Border Width="14" Height="14" CornerRadius="3" Background="#FF5964" VerticalAlignment="Center"/>
                      <TextBlock Text="GPU" Classes="cardtitle"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="Details ›" Classes="dim" FontSize="10.5"/>
                  </Grid>
                  <controls:RingGauge Width="100" Height="100" Thickness="9" Stroke="#FF5964"
                                      ValueText="{Binding GpuText, FallbackValue='—'}" Caption="GPU" HorizontalAlignment="Center"/>
                  <TextBlock Text="{Binding GpuNameText, FallbackValue='—'}" Classes="num" FontSize="10" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding GpuMemoryText, FallbackValue='—'}" Classes="dim num" FontSize="10" HorizontalAlignment="Center"/>
                </StackPanel>
              </Border>

              <!-- THERMAL -->
              <Border Grid.Column="6" Classes="panel dashboard-card metric-card" x:CompileBindings="False" Tag="Thermal" PointerPressed="DashboardCard_OnPointerPressed">
                <StackPanel Spacing="12">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Border Width="14" Height="14" CornerRadius="3" Background="#FFB23F" VerticalAlignment="Center"/>
                      <TextBlock Text="Thermal" Classes="cardtitle"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="Details ›" Classes="dim" FontSize="10.5"/>
                  </Grid>
                  <!-- Shows the CPU when it has a sensor, otherwise the best available component (caption says which). -->
                  <controls:RingGauge Width="100" Height="100" Thickness="9" Stroke="#FFB23F"
                                      ValueText="{Binding ThermalText, FallbackValue='—'}" Caption="{Binding ThermalCaption, FallbackValue='Temp'}"
                                      HorizontalAlignment="Center"/>
                  <TextBlock Text="{Binding ThermalStatusText, FallbackValue='—'}" Classes="num" FontSize="10.5" HorizontalAlignment="Center"/>
                  <TextBlock Text="{Binding ThermalSensorsText, FallbackValue='—'}" Classes="dim num" FontSize="10"
                             TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"/>
                </StackPanel>
              </Border>

              </Grid>
              <Grid x:Name="BottomCards" ColumnDefinitions="*,14,*,14,*">

              <!-- DISK -->
              <Border Classes="panel dashboard-card dashboard-bottom-card" Tag="Disk" PointerPressed="DashboardCard_OnPointerPressed">
                <StackPanel Spacing="12">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Border Width="14" Height="14" CornerRadius="3" Background="#45D6A1" VerticalAlignment="Center"/>
                      <TextBlock Text="Disk" Classes="cardtitle"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding DiskItems.Count, StringFormat='{}{0} volumes ›'}" Classes="dim" FontSize="10.5"/>
                  </Grid>
                  <Grid ColumnDefinitions="Auto,*">
                    <controls:RingGauge Width="106" Height="106" Thickness="9" Stroke="#45D6A1" Value="{Binding StoragePercent}"
                                        ValueText="{Binding StoragePercent, StringFormat='{}{0:F1}%'}" Caption="Disk"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0" Spacing="5">
                      <TextBlock Text="{Binding StorageHeadline}" Classes="num" FontSize="11"/>
                      <TextBlock Text="{Binding StorageDetail}" Classes="muted num" FontSize="10.5"/>
                      <ItemsControl ItemsSource="{Binding DiskItems}" Margin="0,2,0,0">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Grid ColumnDefinitions="*,Auto" Margin="0,1">
                              <TextBlock Text="{Binding Name}" Classes="dim" FontSize="10" TextTrimming="CharacterEllipsis"
                                         ToolTip.Tip="{Binding Value}"/>
                              <TextBlock Grid.Column="1" Text="{Binding Percent, StringFormat='{}{0:F0}%'}" Classes="dim num" FontSize="10" Margin="8,0,0,0"/>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Border>

              <!-- BATTERY (optional data) -->
              <Border Grid.Column="2" Classes="panel dashboard-card dashboard-bottom-card" x:CompileBindings="False" Tag="Battery" PointerPressed="DashboardCard_OnPointerPressed">
                <StackPanel Spacing="12">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Border Width="14" Height="14" CornerRadius="3" Background="#FFB23F" VerticalAlignment="Center"/>
                      <TextBlock Text="Battery" Classes="cardtitle"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="Details ›" Classes="dim" FontSize="10.5"/>
                  </Grid>
                  <Grid ColumnDefinitions="Auto,*">
                    <controls:RingGauge Width="116" Height="116" Thickness="10" Stroke="#FFB23F"
                                        ValueText="{Binding BatteryText, FallbackValue='—'}" Caption="Battery"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0" Spacing="8">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Status" Classes="muted" FontSize="11"/>
                        <TextBlock Grid.Column="1" Text="{Binding BatteryStatusText, FallbackValue='—'}" Classes="num" FontSize="11"/>
                      </Grid>
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Health" Classes="muted" FontSize="11"/>
                        <TextBlock Grid.Column="1" Text="{Binding BatteryHealthText, FallbackValue='—'}" Classes="num" FontSize="11"/>
                      </Grid>
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Border>

              <!-- NETWORK -->
              <Border Grid.Column="4" Classes="panel dashboard-card dashboard-bottom-card" x:CompileBindings="False" Tag="Network" PointerPressed="DashboardCard_OnPointerPressed">
                <StackPanel Spacing="12">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Ellipse Width="14" Height="14" Fill="#00AEEF" VerticalAlignment="Center"/>
                      <TextBlock Text="Network" Classes="cardtitle"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="Details ›" Classes="dim" FontSize="10.5"/>
                  </Grid>
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                      <TextBlock Text="↓ Download" Foreground="#45D6A1" Classes="num" FontSize="10.5"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding NetworkDownText, FallbackValue='—'}" Classes="num" FontSize="11"/>
                  </Grid>
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="↑ Upload" Foreground="#00AEEF" Classes="num" FontSize="10.5"/>
                    <TextBlock Grid.Column="1" Text="{Binding NetworkUpText, FallbackValue='—'}" Classes="num" FontSize="11"/>
                  </Grid>
                  <Border Height="1" Background="#25313A"/>
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Total received" Classes="muted" FontSize="10.5"/>
                    <TextBlock Grid.Column="1" Text="{Binding NetworkTotalInText, FallbackValue='—'}" Classes="num" FontSize="10.5"/>
                  </Grid>
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Total sent" Classes="muted" FontSize="10.5"/>
                    <TextBlock Grid.Column="1" Text="{Binding NetworkTotalOutText, FallbackValue='—'}" Classes="num" FontSize="10.5"/>
                  </Grid>
                </StackPanel>
              </Border>
              </Grid>
            </StackPanel>

          </StackPanel>
        </ScrollViewer>

        <!-- ============ VIEW: STORAGE EXPLORER ============ -->
        <Grid IsVisible="{Binding IsStorageExplorerActive}" Background="#080C0F" Margin="20,16,20,14" RowDefinitions="Auto,Auto,*,Auto,1.3*,Auto">

          <!-- Scan bar -->
          <Border Classes="storage-toolbar" Padding="0" Margin="0,0,0,10">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                <TextBox Classes="storage-path" Text="{Binding StorageExplorer.ScanPath}" Watermark="Folder to scan, e.g. /home/user or /" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                <Button Grid.Column="1" Content="Browse…" Classes="storage-action" Command="{Binding StorageExplorer.BrowseFolderCommand}" Margin="0,0,8,0"/>
                <Button Grid.Column="2" Content="Scan" Classes="primary storage-action" Padding="20,7"
                        Command="{Binding StorageExplorer.ScanCommand}" IsEnabled="{Binding StorageExplorer.CanScan}" Margin="0,0,8,0"/>
                <Button Grid.Column="3" Content="Cancel" Classes="storage-action"
                        Command="{Binding StorageExplorer.CancelCommand}" IsEnabled="{Binding StorageExplorer.IsScanning}"/>
              </Grid>
              <Grid ColumnDefinitions="Auto,*">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Button Content="/" Classes="storage-chip" Command="{Binding StorageExplorer.SetQuickPathCommand}" CommandParameter="/"/>
                  <Button Content="~" Classes="storage-chip" Command="{Binding StorageExplorer.SetQuickPathCommand}" CommandParameter="~"/>
                  <Button Content="Downloads" Classes="storage-chip" Command="{Binding StorageExplorer.SetQuickPathCommand}" CommandParameter="~/Downloads"/>
                  <Button Content="/var" Classes="storage-chip" Command="{Binding StorageExplorer.SetQuickPathCommand}" CommandParameter="/var"/>
                  <Button Content="/usr" Classes="storage-chip" Command="{Binding StorageExplorer.SetQuickPathCommand}" CommandParameter="/usr"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding StorageExplorer.StatusMessage}" Classes="muted" FontSize="12"
                           HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
              </Grid>
            </StackPanel>
          </Border>

          <!-- Drives -->
          <Border Grid.Row="1" Classes="storage-surface" Padding="10" Margin="0,0,0,10">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="VOLUMES" Classes="eyebrow" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="Refresh" Classes="sm storage-action" Command="{Binding StorageExplorer.RefreshDrivesCommand}"/>
              </Grid>
              <ItemsControl ItemsSource="{Binding StorageExplorer.AvailableDrives}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Classes="storage-drive" Margin="0,0,8,0">
                    <Button Classes="storage-drive"
                            Command="{Binding $parent[Window].DataContext.StorageExplorer.SelectDriveCommand}"
                            CommandParameter="{Binding}">
                      <StackPanel Width="210" Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                          <TextBlock Text="{Binding Icon}" FontSize="17" VerticalAlignment="Center"/>
                          <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding MountPoint}" Classes="muted num" FontSize="10" TextTrimming="CharacterEllipsis"/>
                          </StackPanel>
                        </StackPanel>
                        <ProgressBar Value="{Binding UsagePercent}" Maximum="100" Foreground="#3FCF6B"/>
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Text="{Binding FormattedCapacity}" Classes="muted num" FontSize="10.5"/>
                          <TextBlock Grid.Column="1" Text="{Binding FormattedFree}" Foreground="#3FCF6B" Classes="num" FontSize="10.5"/>
                        </Grid>
                      </StackPanel>
                    </Button>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- Tree + extensions -->
          <Grid Grid.Row="2" ColumnDefinitions="*,12,*">
            <Border Classes="storage-surface" Padding="14,12">
              <Grid RowDefinitions="Auto,*">
                <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,10,8">
                  <TextBlock Text="FOLDERS · SIZE SHARE" Classes="eyebrow"/>
                  <TextBlock Grid.Column="1" Text="Size" Classes="eyebrow" Margin="0,0,22,0"/>
                  <TextBlock Grid.Column="2" Text="Share" Classes="eyebrow"/>
                </Grid>
                <TreeView Grid.Row="1" Background="Transparent" ItemsSource="{Binding StorageExplorer.RootNodes}"
                          SelectedItem="{Binding StorageExplorer.SelectedNode, Mode=TwoWay}">
                  <TreeView.ItemTemplate>
                    <TreeDataTemplate ItemsSource="{Binding Children}">
                      <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,2">
                        <TextBlock Text="{Binding IconText}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="320"/>
                        <TextBlock Grid.Column="2" Text="{Binding FormattedSize}" Classes="num" Foreground="#7FDB9E" FontSize="11.5"
                                   Margin="10,0,14,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="{Binding FormattedPercent}" Classes="muted num" FontSize="11" VerticalAlignment="Center" MinWidth="40" TextAlignment="Right"/>
                      </Grid>
                    </TreeDataTemplate>
                  </TreeView.ItemTemplate>
                </TreeView>
              </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Background="Transparent" ResizeDirection="Columns"/>

            <Border Grid.Column="2" Classes="storage-surface" Padding="14,12">
              <Grid RowDefinitions="Auto,*">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,0,6,8">
                  <TextBlock Text="FILE TYPES" Classes="eyebrow"/>
                  <TextBlock Grid.Column="1" Text="Category" Classes="eyebrow" Margin="42,0,8,0" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Grid.Column="2" Text="Size" Classes="eyebrow" Margin="0,0,16,0"/>
                  <TextBlock Grid.Column="3" Text="Share" Classes="eyebrow"/>
                </Grid>
                <ScrollViewer Grid.Row="1">
                  <ItemsControl ItemsSource="{Binding StorageExplorer.Extensions}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border BorderBrush="#262B32" BorderThickness="0,0,0,1" Padding="2,7">
                          <Grid ColumnDefinitions="Auto,64,*,Auto,Auto">
                            <Border Background="{Binding ColorHex}" CornerRadius="3" Width="10" Height="10" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Extension}" Classes="num" FontWeight="SemiBold" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding Category}" Classes="muted" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="{Binding FormattedSize}" Classes="num" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <TextBlock Grid.Column="4" Text="{Binding FormattedPercent}" Classes="muted num" FontSize="11" VerticalAlignment="Center" MinWidth="40" TextAlignment="Right"/>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Grid>
            </Border>
          </Grid>

          <GridSplitter Grid.Row="3" Height="10" Background="Transparent" ResizeDirection="Rows"/>

          <!-- Disk map -->
          <Border Grid.Row="4" Classes="storage-surface" Padding="0" ClipToBounds="True">
            <Grid RowDefinitions="Auto,*">
              <Grid Margin="16,12,16,10" ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <TextBlock Text="Disk Map" Classes="cardtitle" VerticalAlignment="Center"/>
                  <TextBlock Text="Block area = disk usage" Classes="dim" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding StorageExplorer.ScannedFilesText}" Classes="muted num" FontSize="11"/>
              </Grid>
              <controls:TreemapControl Grid.Row="1" x:Name="TreemapDisplay"
                                       Items="{Binding StorageExplorer.TreemapItems}"
                                       SelectedItem="{Binding StorageExplorer.SelectedTreemapItem, Mode=TwoWay}"
                                       HoveredItem="{Binding StorageExplorer.HoveredTreemapItem, Mode=TwoWay}"/>
            </Grid>
          </Border>

          <!-- Inspector -->
          <Border Grid.Row="5" Classes="storage-surface" Padding="14,9" Margin="0,10,0,0">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding StorageExplorer.HoveredInfoText}" VerticalAlignment="Center" FontSize="12"
                         Foreground="#C4CAD1" TextTrimming="CharacterEllipsis"/>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" IsEnabled="{Binding StorageExplorer.HasSelection}">
                <Button Content="Reveal" Classes="sm" ToolTip.Tip="Open in file manager" Command="{Binding StorageExplorer.OpenFolderCommand}"/>
                <Button Content="Terminal" Classes="sm" ToolTip.Tip="Open terminal here" Command="{Binding StorageExplorer.OpenTerminalCommand}"/>
                <Button Content="Copy path" Classes="sm" ToolTip.Tip="Copy path to clipboard" Command="{Binding StorageExplorer.CopyPathCommand}"/>
                <Button Content="Ask assistant" Classes="sm primary" ToolTip.Tip="Ask the assistant about this item" Command="{Binding StorageExplorer.AskAiAboutSelectedCommand}"/>
                <Button Content="Move to trash" Classes="sm danger" ToolTip.Tip="Move to trash" Command="{Binding StorageExplorer.MoveToTrashCommand}"/>
              </StackPanel>
            </Grid>
          </Border>
        </Grid>

        <!-- ============ VIEW: CLEANUP ============ -->
        <ScrollViewer IsVisible="{Binding IsCleanupActive}" Background="#080C0F">
          <StackPanel Spacing="14" Margin="28,22">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="4">
                <TextBlock Text="Cleanup" Classes="h1"/>
                <TextBlock Text="Find caches, orphaned packages and build artifacts you can safely reclaim." Classes="muted" FontSize="12" TextWrapping="Wrap"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="Scan" Classes="cleanup-action" Command="{Binding Cleanup.ScanCommand}" IsEnabled="{Binding Cleanup.CanOperate}"/>
                <Button Content="Clean selected" Classes="primary cleanup-action" Command="{Binding Cleanup.CleanSelectedCommand}" IsEnabled="{Binding Cleanup.CanOperate}"/>
              </StackPanel>
            </Grid>

            <Grid ColumnDefinitions="*,12,*,12,*">
              <Border Classes="cleanup-surface" Padding="14">
                <StackPanel Spacing="6">
                  <TextBlock Text="DETECTED" Classes="eyebrow"/>
                  <TextBlock Text="{Binding Cleanup.TotalReclaimableText}" Classes="big" Foreground="#00AEEF"/>
                  <TextBlock Text="Across cache and temp targets" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Classes="cleanup-surface" Padding="14">
                <StackPanel Spacing="6">
                  <TextBlock Text="SELECTED" Classes="eyebrow"/>
                  <TextBlock Text="{Binding Cleanup.SelectedReclaimableText}" Classes="big" Foreground="#45D6A1"/>
                  <TextBlock Text="Will be reclaimed" Classes="muted" FontSize="11"/>
                </StackPanel>
              </Border>
              <Border Grid.Column="4" Classes="cleanup-surface" Padding="14">
                <StackPanel Spacing="6">
                  <TextBlock Text="STATUS" Classes="eyebrow"/>
                  <TextBlock Text="{Binding Cleanup.StatusMessage}" FontSize="12.5" TextWrapping="Wrap" LineHeight="18"/>
                </StackPanel>
              </Border>
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Select all" Classes="sm cleanup-action" Command="{Binding Cleanup.SelectAllCommand}"/>
              <Button Content="Deselect all" Classes="sm cleanup-action" Command="{Binding Cleanup.DeselectAllCommand}"/>
            </StackPanel>

            <Border Classes="cleanup-surface" Padding="0">
              <ItemsControl ItemsSource="{Binding Cleanup.FilteredItems}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Classes="cleanup-row" Padding="16,12">
                      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <StackPanel Grid.Column="1" Spacing="4">
                          <StackPanel Orientation="Horizontal" Spacing="9">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"/>
                            <Border Background="Transparent" BorderBrush="{Binding BadgeColor}" BorderThickness="1" CornerRadius="0" Padding="6,1" VerticalAlignment="Center">
                              <TextBlock Text="{Binding RiskLevel}" FontSize="9.5" FontWeight="Bold" Foreground="{Binding BadgeColor}"/>
                            </Border>
                            <TextBlock Text="{Binding Category}" Classes="muted" FontSize="11" VerticalAlignment="Center"/>
                          </StackPanel>
                          <TextBlock Text="{Binding Description}" Classes="muted" FontSize="11.5" TextWrapping="Wrap"/>
                          <TextBlock Text="{Binding Path}" Classes="dim num" FontSize="10.5" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding FormattedSize}" Classes="num" Foreground="#45D6A1" FontSize="15" FontWeight="Medium"
                                   VerticalAlignment="Center" Margin="18,0"/>
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                          <Button Content="Reveal" Classes="sm cleanup-action"
                                  Command="{Binding $parent[Window].DataContext.Cleanup.OpenItemLocationCommand}" CommandParameter="{Binding}"/>
                          <Button Content="Ask assistant" Classes="sm cleanup-action"
                                  Command="{Binding $parent[Window].DataContext.Cleanup.AskAiAboutItemCommand}" CommandParameter="{Binding}"/>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- ============ VIEW: PROCESSES ============ -->
        <Grid IsVisible="{Binding IsPerformanceActive}" Background="#080C0F" Margin="20,16,20,14" RowDefinitions="Auto,Auto,*">
          <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,14">
            <StackPanel Spacing="3">
              <TextBlock Text="Processes" Classes="h1"/>
              <TextBlock Text="{Binding Performance.StatusMessage}" Classes="muted" FontSize="12"/>
            </StackPanel>
            <Button Grid.Column="1" Classes="process-action" Content="Refresh" Command="{Binding Performance.RefreshCommand}" VerticalAlignment="Center"/>
          </Grid>

          <Border Grid.Row="1" Classes="process-surface" Padding="12" Margin="0,0,0,12">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="4,0,22,0">
                <TextBlock Text="CPU" Classes="eyebrow" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Performance.CpuText}" Classes="num" FontWeight="SemiBold" Foreground="#00AEEF"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,22,0">
                <TextBlock Text="RAM" Classes="eyebrow" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Performance.MemoryHeadline}" Classes="num" FontWeight="SemiBold" Foreground="#FFB23F"/>
              </StackPanel>
              <TextBox Grid.Column="2" Classes="process-search" Text="{Binding Performance.SearchFilter}" Watermark="Filter by name or PID…" VerticalContentAlignment="Center" Margin="0,0,12,0"/>
              <Button Grid.Column="3" Content="End task" Classes="danger process-action"
                      Command="{Binding Performance.TerminateProcessCommand}" IsEnabled="{Binding Performance.HasSelectedProcess}"/>
            </Grid>
          </Border>

          <Border Grid.Row="2" Classes="process-surface" Padding="0">
            <Grid RowDefinitions="Auto,*">
              <Grid ColumnDefinitions="80,*,120" Margin="16,12,16,8">
                <TextBlock Text="PID" Classes="eyebrow"/>
                <TextBlock Grid.Column="1" Text="PROCESS" Classes="eyebrow"/>
                <TextBlock Grid.Column="2" Text="Memory" Classes="eyebrow" HorizontalAlignment="Right"/>
              </Grid>
              <ListBox Grid.Row="1" Classes="process-list" ItemsSource="{Binding Performance.FilteredProcesses}"
                       SelectedItem="{Binding Performance.SelectedProcess, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="#25313A" BorderThickness="0,1,0,0" Padding="16,10">
                      <Grid ColumnDefinitions="80,*,120">
                        <TextBlock Text="{Binding Id}" Classes="muted num" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="2" Text="{Binding MemoryMb, StringFormat='{}{0:F1} MB'}" Classes="num"
                                   Foreground="#45D6A1" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>
        </Grid>

        <!-- ============ VIEW: SYSTEM HEALTH ============ -->
        <ScrollViewer IsVisible="{Binding IsAnomaliesActive}" Background="#080C0F">
          <StackPanel Spacing="14" MaxWidth="1120" Margin="28,22">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="4">
                <TextBlock Text="System Health" Classes="h1"/>
                <TextBlock Text="Crash, hardware, driver, storage, and shutdown history from Windows Event Log or the Linux system journal." Classes="muted" FontSize="12" TextWrapping="Wrap"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="{Binding Anomalies.RangeLabel}" Classes="health-action" Command="{Binding Anomalies.CycleRangeCommand}"/>
                <Button Content="Scan now" Classes="primary health-action" Command="{Binding Anomalies.ScanCommand}" IsEnabled="{Binding !Anomalies.IsScanning}"/>
              </StackPanel>
            </Grid>

            <Grid ColumnDefinitions="*,12,*,12,*">
              <Border Classes="health-surface" Padding="14">
                <StackPanel Spacing="4"><TextBlock Text="EVENTS" Classes="eyebrow"/><TextBlock Text="{Binding Anomalies.TotalCount}" Classes="big" Foreground="#E6E8EB"/></StackPanel>
              </Border>
              <Border Grid.Column="2" Classes="health-surface" Padding="14">
                <StackPanel Spacing="4"><TextBlock Text="CRITICAL" Classes="eyebrow"/><TextBlock Text="{Binding Anomalies.CriticalCount}" Classes="big" Foreground="#F0525F"/></StackPanel>
              </Border>
              <Border Grid.Column="4" Classes="health-surface" Padding="14">
                <StackPanel Spacing="4"><TextBlock Text="WARNINGS" Classes="eyebrow"/><TextBlock Text="{Binding Anomalies.WarningCount}" Classes="big" Foreground="#FFB23F"/></StackPanel>
              </Border>
            </Grid>

            <StackPanel Spacing="7">
              <TextBlock Text="Category breakdown" Classes="eyebrow"/>
              <ItemsControl ItemsSource="{Binding Anomalies.Categories}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Classes="health-category" Padding="9,6" Margin="0,0,8,8">
                      <StackPanel Orientation="Horizontal" Spacing="7">
                        <Ellipse Width="7" Height="7" Fill="{Binding Color}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Name}" FontSize="11"/>
                        <TextBlock Text="{Binding Count}" Classes="num" Foreground="#E6E8EB" FontWeight="SemiBold"/>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <Border Classes="health-surface" Padding="10">
              <StackPanel Spacing="12">
                <TextBlock Text="{Binding Anomalies.StatusMessage}" Classes="muted" FontSize="11"/>
                <Grid ColumnDefinitions="*,12,220">
                  <TextBox Classes="health-filter" Text="{Binding Anomalies.SearchText}" Watermark="Search events, source, or category…"/>
                  <ComboBox Grid.Column="2" Classes="health-filter" ItemsSource="{Binding Anomalies.CategoryFilters}" SelectedItem="{Binding Anomalies.SelectedCategory, Mode=TwoWay}"/>
                </Grid>
              </StackPanel>
            </Border>

            <Border Classes="health-surface" Padding="0">
              <Grid RowDefinitions="Auto,*">
                <Grid ColumnDefinitions="105,*,Auto" Margin="16,12,16,8">
                  <TextBlock Text="SEVERITY" Classes="eyebrow"/>
                  <TextBlock Grid.Column="1" Text="EVENT" Classes="eyebrow"/>
                  <TextBlock Grid.Column="2" Text="WHEN" Classes="eyebrow"/>
                </Grid>
                <StackPanel Grid.Row="1" Spacing="0">
                  <TextBlock IsVisible="{Binding !Anomalies.HasEvents}" Text="No saved events match this filter. Use Scan now to inspect recent Windows Event Logs or the Linux system journal." Classes="muted" Margin="16,8,16,16" TextWrapping="Wrap"/>
                  <ItemsControl ItemsSource="{Binding Anomalies.Events}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="models:AnomalyRecord">
                        <Border BorderBrush="#25313A" BorderThickness="0,1,0,0" Padding="16,12">
                          <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="105,*,Auto">
                              <TextBlock Text="{Binding SeverityBadge}" Foreground="{Binding SeverityColor}" Classes="num" FontWeight="SemiBold"/>
                              <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding CategoryLabel}" Classes="muted" FontSize="11"/>
                              </StackPanel>
                              <TextBlock Grid.Column="2" Text="{Binding RelativeTime}" Classes="muted num" Margin="16,0,0,0"/>
                            </Grid>
                            <TextBlock Text="{Binding Details}" Classes="muted" FontSize="11" TextWrapping="Wrap" MaxHeight="54" TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                              <TextBlock Text="{Binding Source}" Classes="dim num" FontSize="10" VerticalAlignment="Center"/>
                              <Button Content="Why this happened" Classes="chip" Command="{Binding $parent[Window].DataContext.Anomalies.ExplainCommand}" CommandParameter="{Binding}"/>
                            </StackPanel>
                            <Border IsVisible="{Binding HasExplanation}" Background="#171A1E" Padding="10" CornerRadius="6">
                              <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap"/>
                            </Border>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>

      </Grid>

      <!-- ============ DASHBOARD DETAIL DRAWER (opens on card click) ============ -->
      <Border x:Name="DetailDrawer" Grid.RowSpan="2" IsVisible="False"
              x:CompileBindings="False"
              HorizontalAlignment="Right" Width="400" Margin="0,14,14,14"
              Background="#1A1F26" BorderBrush="#3A6BA8" BorderThickness="1" CornerRadius="14" Padding="0"
              BoxShadow="0 8 32 0 #99000000">
        <Grid RowDefinitions="Auto,*,Auto">

          <!-- Header -->
          <Border Padding="18,16,14,12" BorderBrush="#2A2F36" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Border x:Name="DetailSwatch" Width="12" Height="12" CornerRadius="3" Background="#4D96F0"
                      VerticalAlignment="Center" Margin="0,0,10,0"/>
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock x:Name="DetailTitle" Text="Details" FontSize="15" FontWeight="SemiBold"/>
                <TextBlock x:Name="DetailSubtitle" Text="" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
              </StackPanel>
              <Button Grid.Column="2" Classes="sm" Click="DetailClose_OnClick" VerticalAlignment="Top" ToolTip.Tip="Close">
                <Path Width="9" Height="9" Stretch="Uniform" Stroke="#DADEE3" StrokeThickness="1.4" StrokeLineCap="Round"
                      Data="M1,1 L8,8 M8,1 L1,8"/>
              </Button>
            </Grid>
          </Border>

          <!-- Body -->
          <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="14" Margin="18,14">
              <StackPanel Spacing="6">
                <TextBlock Text="LIVE VALUES" Classes="eyebrow"/>
                <ItemsControl x:Name="DetailRows">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border BorderBrush="#262B32" BorderThickness="0,0,0,1" Padding="0,7">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Text="{Binding Label}" Classes="muted" FontSize="11.5" TextWrapping="Wrap" MaxWidth="170"
                                     HorizontalAlignment="Left"/>
                          <TextBlock Grid.Column="1" Text="{Binding Value}" Classes="num" FontSize="11.5" FontWeight="SemiBold"
                                     TextWrapping="Wrap" MaxWidth="190" TextAlignment="Right"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <StackPanel Spacing="6">
                <TextBlock Text="WHAT THIS MEANS" Classes="eyebrow"/>
                <TextBlock x:Name="DetailExplain" Classes="muted" FontSize="12" TextWrapping="Wrap" LineHeight="18"/>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>

          <!-- Footer -->
          <Border Grid.Row="2" Padding="14,12" BorderBrush="#2A2F36" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
              <Button Content="Close" Click="DetailClose_OnClick"/>
              <Button Content="Ask assistant" Classes="primary" Click="DetailAsk_OnClick"/>
            </StackPanel>
          </Border>
        </Grid>
      </Border>
    </Grid>

    <GridSplitter Grid.Column="3" Classes="pane-resizer" ResizeDirection="Columns"
                  ResizeBehavior="PreviousAndNext" ShowsPreview="False"/>

    <!-- ===================== ASSISTANT RAIL ===================== -->
    <Border Grid.Column="4" Classes="chat-rail" Background="#080C0F" BorderBrush="#1D2A33" BorderThickness="1,0,0,0">
      <Grid RowDefinitions="*,Auto">

        <!-- Sphere + prompt (glowing box) -->
        <Grid Grid.Row="1" Margin="14,12,14,14">
          <Border Background="#0D1318" CornerRadius="4" BorderBrush="#263842" BorderThickness="1" Padding="8">
            <Grid ColumnDefinitions="64,*,44">
              <Grid Width="56" Height="56" VerticalAlignment="Top" Margin="0,2,8,0">
                <controls:AssistantSphere IsActive="{Binding IsAiThinking}" IsEngaged="{Binding HasPrompt}" Accent="#00AEEF"/>
              </Grid>

              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="Assistant" Classes="cardtitle"/>
                  <TextBlock Text="· ready" Classes="dim" FontSize="10.5" IsVisible="{Binding !IsAiThinking}" VerticalAlignment="Center"/>
                  <TextBlock Text="· analysing…" Foreground="#00AEEF" FontSize="10.5" IsVisible="{Binding IsAiThinking}" VerticalAlignment="Center"/>
                </StackPanel>
                <!-- Chips wrap onto another line in a narrow rail instead of being clipped. -->
                <WrapPanel Margin="0,0,0,-6">
                  <Button Content="Break down scan" Classes="chip" Margin="0,0,6,6" Command="{Binding QuickAskCommand}" CommandParameter="What is taking up all my space? Break down the scan."/>
                  <Button Content="Safe cleanups" Classes="chip" Margin="0,0,6,6" Command="{Binding QuickAskCommand}" CommandParameter="What can I safely clean up to free disk space?"/>
                  <Button Content="node__modules" Classes="chip" Margin="0,0,6,6" Command="{Binding QuickAskCommand}" CommandParameter="What is node_modules, and can I delete it?"/>
                  <Button Content="Check memory" Classes="chip" Margin="0,0,6,6" Command="{Binding QuickAskCommand}" CommandParameter="Why is my RAM being used?"/>
                </WrapPanel>
                <TextBox Text="{Binding Prompt}" Watermark="Ask about disk, memory, or a file…"
                         MinHeight="40" VerticalContentAlignment="Center" FontSize="12.5" TextWrapping="Wrap"
                         IsEnabled="{Binding !IsAiThinking}">
                  <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding SendCommand}"/>
                  </TextBox.KeyBindings>
                </TextBox>
              </StackPanel>

              <Button Grid.Column="2" Classes="primary send-icon" Command="{Binding SendCommand}"
                      Width="40" Height="40" VerticalAlignment="Bottom" Margin="8,0,0,0"
                      IsEnabled="{Binding !IsAiThinking}"
                      ToolTip.Tip="Ask assistant">
                <PathIcon Data="M409 337C418.4 327.6 418.4 312.4 409 303.1L265 159C258.1 152.1 247.8 150.1 238.8 153.8C229.8 157.5 224 166.3 224 176L224 256L112 256C85.5 256 64 277.5 64 304L64 336C64 362.5 85.5 384 112 384L224 384L224 464C224 473.7 229.8 482.5 238.8 486.2C247.8 489.9 258.1 487.9 265 481L409 337zM416 480C398.3 480 384 494.3 384 512C384 529.7 398.3 544 416 544L480 544C533 544 576 501 576 448L576 192C576 139 533 96 480 96L416 96C398.3 96 384 110.3 384 128C384 145.7 398.3 160 416 160L480 160C497.7 160 512 174.3 512 192L512 448C512 465.7 497.7 480 480 480L416 480z"
                          Width="18" Height="18" Foreground="White"/>
              </Button>
            </Grid>
          </Border>
        </Grid>

        <!-- Conversation fills the upper rail; the prompt stays anchored at the bottom. -->
        <StackPanel Grid.Row="0" Margin="22,14" Spacing="7" IsVisible="{Binding !HasMessages}"
                    VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="300">
          <TextBlock Text="Ask about this screen" FontSize="17" FontWeight="SemiBold" Foreground="#E6E8EB"
                     TextAlignment="Center"/>
          <TextBlock Text="I can explain what you’re seeing." Classes="muted" FontSize="12"
                     TextWrapping="Wrap" TextAlignment="Center"/>
        </StackPanel>
        <Border Grid.Row="0" Margin="14,14,14,0" Padding="4,0" IsVisible="{Binding HasMessages}">
          <Grid RowDefinitions="Auto,*">
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
              <TextBlock Text="Conversation" Classes="eyebrow" VerticalAlignment="Center"/>
              <Button Grid.Column="1" Content="Clear" Classes="sm" Command="{Binding ClearChatCommand}"/>
            </Grid>
            <ScrollViewer Grid.Row="1">
              <StackPanel>
                <ItemsControl ItemsSource="{Binding Messages}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{Binding Background}" BorderBrush="#263842" BorderThickness="1" CornerRadius="4"
                              Padding="12,10" Margin="0,0,0,8" HorizontalAlignment="{Binding Alignment}" MaxWidth="300">
                        <StackPanel Spacing="4">
                          <TextBlock Text="{Binding Author}" FontSize="9.5" FontWeight="SemiBold" LetterSpacing="1.1" Foreground="#00AEEF"/>
                          <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" FontSize="12.5" LineHeight="19" Foreground="#E6E8EB"/>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border IsVisible="{Binding IsAiThinking}" Background="#101C23" BorderBrush="#234556" BorderThickness="1"
                        CornerRadius="4" Padding="12,9" Margin="0,0,0,8" HorizontalAlignment="Left">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <controls:ThinkingIndicator Width="42" Height="18" IsActive="{Binding IsAiThinking}"/>
                    <TextBlock Text="DiagnoX is thinking" Classes="muted" FontSize="11.5" VerticalAlignment="Center"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Border>

      </Grid>
    </Border>
  </Grid>
</Window>
